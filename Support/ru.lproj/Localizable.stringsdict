<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld chars</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld символа</string>
			<key>many</key>
			<string>%lld символов</string>
			<key>one</key>
			<string>%lld символ</string>
			<key>other</key>
			<string>%lld символа</string>
		</dict>
	</dict>
	<key>%lld items, %lld images</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@, %#@images@</string>
		<key>images</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld изображения</string>
			<key>many</key>
			<string>%lld изображений</string>
			<key>one</key>
			<string>%lld изображение</string>
			<key>other</key>
			<string>%lld изображения</string>
		</dict>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld записи</string>
			<key>many</key>
			<string>%lld записей</string>
			<key>one</key>
			<string>%lld запись</string>
			<key>other</key>
			<string>%lld записи</string>
		</dict>
	</dict>
	<key>%lld lines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld строки</string>
			<key>many</key>
			<string>%lld строк</string>
			<key>one</key>
			<string>%lld строка</string>
			<key>other</key>
			<string>%lld строки</string>
		</dict>
	</dict>
	<key>File: %@ and %lld more</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Файл: %@ и ещё %#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld файла</string>
			<key>many</key>
			<string>%lld файлов</string>
			<key>one</key>
			<string>%lld файл</string>
			<key>other</key>
			<string>%lld файла</string>
		</dict>
	</dict>
	<key>Keep %lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld дня</string>
			<key>many</key>
			<string>%lld дней</string>
			<key>one</key>
			<string>%lld день</string>
			<key>other</key>
			<string>%lld дня</string>
		</dict>
	</dict>
</dict>
</plist>
